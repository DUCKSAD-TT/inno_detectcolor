import cv2

print("กำลังทดสอบเปิดกล้อง ID: 1 ...")
cap = cv2.VideoCapture(1, cv2.CAP_DSHOW)

if not cap.isOpened():
    print("เปิดกล้อง ID 1 ไม่สำเร็จ กำลังลองเปิด ID 0 ...")
    cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)

if cap.isOpened():
    print("✅ เปิดกล้องสำเร็จ! (กดปุ่ม 'q' บนคีย์บอร์ดเพื่อปิดหน้าต่าง)")
    while True:
        ret, frame = cap.read()
        if ret:
            cv2.imshow("Camera Test", frame)
            # กด q เพื่อออกจากโปรแกรม
            if cv2.waitKey(1) & 0xFF == ord('q'):
                break
        else:
            print("❌ กล้องเชื่อมต่อได้ แต่ดึงภาพไม่ได้ (ลองเช็คสาย USB หรือถอดเสียบใหม่)")
            break
    cap.release()
    cv2.destroyAllWindows()
else:
    print("❌ หาฮาร์ดแวร์กล้องไม่เจอเลยครับ โปรแกรมหรือระบบอื่นอาจจะดึงกล้องไปใช้งานอยู่")
