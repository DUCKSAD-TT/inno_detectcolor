import cv2
import numpy as np
import serial
import csv
import time
import threading
import tkinter as tk
from tkinter import scrolledtext
from PIL import Image, ImageTk

# =================ตั้งค่าระบบ=================
SERIAL_PORT = 'COM7' # พอร์ต Arduino ของคุณ
BAUD_RATE = 9600
CAMERA_ID = 1        # เปลี่ยนให้ตรงกับ ID ที่ทดสอบ test_cam.py แล้วติด
# สี: แดง=1, น้ำเงิน=2, เขียว=3, เหลือง=4
# ==========================================

class RobotApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Robot Arm Sorter Controller")

        self.points = []
        self.is_selecting = False
        self.running_sequence = False
        self.stop_requested = False
        self.current_tk_image = None 

        self.setup_gui()

        try:
            self.serial_conn = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=1)
            self.log(f"เชื่อมต่อ Serial Port ({SERIAL_PORT}) สำเร็จ")
        except Exception as e:
            self.serial_conn = None
            self.log(f"⚠️ ข้อผิดพลาด Serial: {e}")

        # ---------------------------------------------------------
        # ส่วนที่แก้ไขเพื่อแก้บั๊ก -1072875772 (Windows MSMF Bug)
        # ---------------------------------------------------------
        self.log(f"กำลังเชื่อมต่อกล้อง ID: {CAMERA_ID} ...")
        
        # บังคับใช้ DirectShow เพื่อหลีกเลี่ยงระบบ MSMF ที่มีปัญหา
        self.cap = cv2.VideoCapture(CAMERA_ID, cv2.CAP_DSHOW)
        
        # บังคับตั้งค่าความละเอียดทันที (Fix bug จอดำ)
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
        
        if not self.cap.isOpened():
            self.log(f"❌ เปิดกล้อง ID {CAMERA_ID} ไม่สำเร็จ ลองเปลี่ยนเป็นเลข 0 ดูครับ")
        else:
            self.log("✅ เปิดกล้องสำเร็จ! เริ่มประมวลผลภาพ...")
            
        self.update_frame()

    def setup_gui(self):
        self.video_frame = tk.Label(self.root, text="[ กำลังโหลดภาพจากกล้อง... ]", bg="gray", width=80, height=25)
        self.video_frame.grid(row=0, column=0, rowspan=10, padx=10, pady=10)
        self.video_frame.bind("<Button-1>", self.on_mouse_click)

        tk.Button(self.root, text="1. ระบุตำแหน่งสินค้า 5 จุด", command=self.start_selection, bg="lightblue").grid(row=0, column=1, sticky="ew", padx=5)

        test_frame = tk.Frame(self.root)
        test_frame.grid(row=1, column=1, sticky="ew", padx=5)
        tk.Label(test_frame, text="ทดสอบตำแหน่ง:").pack(side=tk.LEFT)
        for i in range(1, 6):
            tk.Button(test_frame, text=f"{i}", command=lambda idx=i: self.test_position(idx)).pack(side=tk.LEFT, padx=2)

        tk.Button(self.root, text="▶ เริ่มการทำงาน (Auto Mode)", command=self.start_auto_mode, bg="lightgreen", font=("Arial", 12, "bold")).grid(row=2, column=1, sticky="ew", pady=5, padx=5)

        tk.Button(self.root, text="🛑 หยุดและกลับท่าเริ่ม (Home)", command=self.stop_and_home, bg="salmon", font=("Arial", 12, "bold")).grid(row=3, column=1, sticky="ew", pady=5, padx=5)

        self.log_text = scrolledtext.ScrolledText(self.root, width=55, height=18)
        self.log_text.grid(row=4, column=1, rowspan=6, padx=10, pady=10)

    def log(self, message):
        timestamp = time.strftime("%H:%M:%S")
        self.log_text.insert(tk.END, f"[{timestamp}] {message}\n")
        self.log_text.see(tk.END)

    def start_selection(self):
        self.points = []
        self.is_selecting = True
        self.log("กรุณาคลิกเลือกตำแหน่งบนภาพ 5 จุด (เรียงจากจุดที่ 1 ไป 5)")

    def on_mouse_click(self, event):
        if self.is_selecting and len(self.points) < 5:
            self.points.append((event.x, event.y))
            self.log(f"บันทึกจุดที่ {len(self.points)}: X={event.x}, Y={event.y}")
            if len(self.points) == 5:
                self.is_selecting = False
                self.log("บันทึกจุดตรวจจับครบ 5 ตำแหน่งเรียบร้อยแล้ว")

    def update_frame(self):
        if self.cap and self.cap.isOpened():
            ret, frame = self.cap.read()
            if ret and frame is not None:
                h, w, _ = frame.shape
                if w > 640:
                    frame = cv2.resize(frame, (640, 480))

                frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

                for i, p in enumerate(self.points):
                    cv2.circle(frame_rgb, p, 6, (0, 255, 0), -1)
                    cv2.circle(frame_rgb, p, 8, (0, 0, 0), 1)
                    cv2.putText(frame_rgb, str(i+1), (p[0]+12, p[1]+5), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)

                img = Image.fromarray(frame_rgb)
                self.current_tk_image = ImageTk.PhotoImage(image=img)
                self.video_frame.configure(image=self.current_tk_image, text="")
            
        self.root.after(30, self.update_frame)

    def detect_color_at_point(self, frame_hsv, x, y):
        h, w, _ = frame_hsv.shape
        x = max(10, min(w - 10, x))
        y = max(10, min(h - 10, y))

        roi = frame_hsv[y-10:y+10, x-10:x+10]

        color_ranges = {
            1: [(0, 70, 50), (10, 255, 255), (170, 70, 50), (180, 255, 255)],  
            2: [(100, 100, 50), (130, 255, 255)],                             
            3: [(36, 50, 50), (85, 255, 255)],                                
            4: [(15, 100, 100), (35, 255, 255)]                               
        }

        max_pixels = 0
        detected_color = 0 

        for color_id, bounds in color_ranges.items():
            if color_id == 1:
                mask1 = cv2.inRange(roi, np.array(bounds[0]), np.array(bounds[1]))
                mask2 = cv2.inRange(roi, np.array(bounds[2]), np.array(bounds[3]))
                mask = mask1 | mask2
            else:
                mask = cv2.inRange(roi, np.array(bounds[0]), np.array(bounds[1]))

            count = cv2.countNonZero(mask)
            if count > max_pixels and count > 30: 
                max_pixels = count
                detected_color = color_id

        color_names = {0: "ไม่มีสินค้า", 1: "แดง", 2: "น้ำเงิน", 3: "เขียว", 4: "เหลือง"}
        return detected_color, color_names[detected_color]

    def send_to_arduino(self, s1, s2, s3, s4):
        if self.serial_conn and self.serial_conn.is_open:
            command = f"<{int(s1)},{int(s2)},{int(s3)},{int(s4)}>"
            self.serial_conn.write(command.encode('utf-8'))
            self.log(f"ส่ง Servo -> S1:{int(s1)} S2:{int(s2)} S3:{int(s3)} S4:{int(s4)}")

    def execute_csv(self, filename, is_last_item=False):
        try:
            with open(filename, 'r') as file:
                reader = csv.reader(file)
                prev_s4 = None

                for row in reader:
                    if self.stop_requested: break
                    if len(row) < 5: continue

                    delay, s1, s2, s3, s4 = map(float, row)

                    if is_last_item and prev_s4 is not None:
                        if s4 < prev_s4:
                            self.log(f"วางชิ้นสุดท้ายสำเร็จ (S4 อ้าออก {prev_s4} -> {s4})")
                            self.send_to_arduino(s1, s2, s3, s4) 
                            return True 

                    self.send_to_arduino(s1, s2, s3, s4)
                    time.sleep(delay / 1000.0)
                    prev_s4 = s4

            return False
        except FileNotFoundError:
            self.log(f"⚠️ ไม่พบไฟล์บันทึกท่าทาง: {filename}")
            return False

    def test_position(self, pos_idx):
        if len(self.points) < 5:
            self.log("⚠️ กรุณาระบุตำแหน่งให้ครบ 5 จุดก่อนทดสอบ")
            return

        def run_test():
            ret, frame = self.cap.read()
            if not ret: 
                self.log("⚠️ ดึงภาพไม่สำเร็จ")
                return
                
            h, w, _ = frame.shape
            if w > 640: frame = cv2.resize(frame, (640, 480))
            
            hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
            x, y = self.points[pos_idx-1]

            color_id, color_name = self.detect_color_at_point(hsv, x, y)
            self.log(f"🔍 ทดสอบตำแหน่ง {pos_idx}: ตรวจพบสี [{color_name}]")

            if color_id != 0:
                filename = f"record-{pos_idx}{color_id}.csv"
                self.log(f"🎬 เริ่มเล่นไฟล์ท่าทาง: {filename}")
                self.execute_csv(filename)
                self.log("✅ จบทดสอบตำแหน่ง")

        threading.Thread(target=run_test, daemon=True).start()

    def start_auto_mode(self):
        if len(self.points) < 5:
            self.log("⚠️ กรุณาระบุตำแหน่งให้ครบ 5 จุดก่อนเข้า Auto Mode")
            return
        if self.running_sequence: return

        self.running_sequence = True
        self.stop_requested = False
        threading.Thread(target=self.auto_sequence, daemon=True).start()

    def auto_sequence(self):
        start_time = time.time()
        self.log("======================================")
        self.log("🚀 เริ่มต้นระบบจัดเก็บอัตโนมัติ")
        self.log("======================================")

        ret, frame = self.cap.read()
        if not ret:
            self.log("❌ ล้มเหลว: กล้องไม่ส่งสัญญาณภาพในโหมด Auto")
            self.running_sequence = False
            return

        h, w, _ = frame.shape
        if w > 640: frame = cv2.resize(frame, (640, 480))
        
        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        tasks = [] 

        for i, (x, y) in enumerate(self.points):
            pos_idx = i + 1
            color_id, color_name = self.detect_color_at_point(hsv, x, y)
            if color_id != 0:
                filename = f"record-{pos_idx}{color_id}.csv"
                tasks.append({"pos": pos_idx, "color": color_name, "file": filename})
                self.log(f"📍 พบสินค้าตำแหน่ง {pos_idx} [สี{color_name}] -> {filename}")
            else:
                self.log(f"📍 ตำแหน่ง {pos_idx} -> ว่างเปล่า")

        if not tasks:
            self.log("ℹ️ ไม่พบกล่องสินค้าบนสายพาน")
            self.running_sequence = False
            return

        for idx, task in enumerate(tasks):
            if self.stop_requested:
                self.log("🛑 สั่งหยุดระบบฉุกเฉินเรียบร้อย")
                break

            is_last = (idx == len(tasks) - 1)
            self.log(f"👉 จัดเก็บชิ้นที่ {idx+1}/{len(tasks)} (ตำแหน่ง {task['pos']} สี {task['color']})")

            early_stop = self.execute_csv(task['file'], is_last_item=is_last)

            if early_stop:
                break 

        total_time = time.time() - start_time
        self.log("======================================")
        self.log(f"🏁 สิ้นสุดกระบวนการ ใช้เวลา {total_time:.2f} วินาที")
        self.running_sequence = False

    def stop_and_home(self):
        self.stop_requested = True
        self.log("🚨 สั่งหยุดและกลับท่า Home")
        self.send_to_arduino(90, 90, 90, 90) 

if __name__ == "__main__":
    root = tk.Tk()
    app = RobotApp(root)
    root.mainloop()
